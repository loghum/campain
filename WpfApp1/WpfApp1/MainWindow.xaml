<wpfApp1:BattleWindowsBase x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpfApp1="clr-namespace:WpfApp1"
        Closing="Window_Closing"
        Width="1920"
        Height="1080"
        Title="Dm window">
    <Grid>
        <Image Name="MapBackgroundImage" Stretch="Uniform" />
        <Canvas Name="BattleCanvas" Background="Transparent" Margin="0,40,0,0"/>
        
        <ComboBox Name="MapSelector" HorizontalAlignment="Left" VerticalAlignment="Top" Width="150" Margin="10"/>
        <ComboBox Name="MeasureSelector" HorizontalAlignment="Left" VerticalAlignment="Top" Width="150" Margin="30"/>
    </Grid>
</wpfApp1:BattleWindowsBase>
